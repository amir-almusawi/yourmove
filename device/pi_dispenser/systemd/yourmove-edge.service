[Unit]
Description=YourMove Edge Supervisor
After=yourmove-go2rtc.service
ConditionPathExists=/etc/yourmove/edge.json

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/yourmove/edge/edge_supervisor.py --config /etc/yourmove/edge.json
WorkingDirectory=/opt/yourmove
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
